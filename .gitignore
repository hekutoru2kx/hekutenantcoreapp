# .NET build output
bin/
obj/
*.user
.vs/
*.suo

# User secrets / local overrides
appsettings.*.local.json
.claude/settings.local.json

# System files
.DS_Store
Thumbs.db

# Runtime logs
*.log

# Compiled Angular bundle — generated by `npm run build` (to frontend/dist/frontend/browser),
# copied into wwwroot at publish time. Never committed: a template repo carrying a stale
# bundle would serve a months-old UI at the API root under `dotnet run`. Develop with `ng serve`.
# The directory itself is kept (via .gitkeep) so .NET's static-files middleware finds it at startup.
/backend/Hekutenantcoreapp.Api/wwwroot/*
!/backend/Hekutenantcoreapp.Api/wwwroot/.gitkeep
